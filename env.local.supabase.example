# When testing against LOCAL Supabase + locally served Edge Functions:
# 1) Run: supabase start
# 2) Run: supabase status   → copy "API URL" and "anon key" (publishable key)
# 3) Copy this file to .env.local in the project root (same folder as package.json)
# 4) Fill in VITE_SUPABASE_PUBLISHABLE_KEY with the anon key from step 2
#
# Vite loads .env.local over .env, so your app will hit localhost while you keep
# production values in .env for other work.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
