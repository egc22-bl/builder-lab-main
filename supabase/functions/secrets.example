# Copy to supabase/functions/.env (gitignored) for LOCAL `supabase functions serve` only.
#   cp supabase/functions/secrets.example supabase/functions/.env
#
# For PRODUCTION / hosted Edge Functions, set the secret in Supabase instead:
#   Dashboard → Edge Functions → Secrets → ANTHROPIC_API_KEY = your sk-ant-… key
#   or: supabase secrets set ANTHROPIC_API_KEY=sk-ant-…   (linked to the same project ref as VITE_SUPABASE_URL)
# The repo root .env used by Vite does NOT pass Anthropic keys to deployed functions.

ANTHROPIC_API_KEY=
